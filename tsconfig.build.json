{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": false
  },
  "tsc-alias": {
    "fileExtensions": {
      "inputGlob": "d.ts"
    }
  },
  "include": ["./src/**/*"],
  "exclude": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/tests/**/*",
    "**/__tests__/**/*",
    "**/__mocks__/**/*",
    "dist",
    "src/cli/entrypoint/file/fixtures/**"
  ]
}
