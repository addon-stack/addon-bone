    "script": "const path = require('node:path');\nconst {execFileSync} = require('node:child_process');\nconst ts = require(path.join(process.cwd(), 'node_modules/typescript'));\nconst root = process.cwd();\nconst state = process.argv[2];\nconst options = {...ts.parseJsonConfigFileContent(ts.readConfigFile(path.join(root, 'tsconfig.json'), ts.sys.readFile).config, ts.sys, root).options, noEmit: true, types: ['node', 'chrome']};\nconst filename = path.join(root, 'tests/integration/types/fixtures/relay-probe.ts');\nconst source = `import {defineRelay} from \"adnbn\";\nimport * as entry from \"adnbn/entry/relay\";\nimport {Builder as ContentBuilder} from \"adnbn/entry/content/vanilla\";\nconst definition = defineRelay({name: \"scanner\", init: () => ({scan: (text: string) => text.length})});\nnew entry.Builder(definition, ContentBuilder);`;\nconst before = new Map();\nif (state !== 'after') {\n    for (const file of ['src/entry/relay/Builder.ts', 'src/entry/relay/index.ts', 'src/types/content/definition.ts']) {\n        before.set(path.join(root, file), execFileSync('git', ['show', `7c4e136e:${file}`], {encoding: 'utf8'}));\n    }\n}\nconst host = ts.createCompilerHost(options);\nconst read = host.readFile.bind(host);\nhost.readFile = file => {\n    if (file === filename) return source;\n    let text = before.has(file) ? before.get(file) : read(file);\n    if (state === 'single-tag' && file === path.join(root, 'src/types/content/common.ts')) {\n        text = text.replace('Exclude<keyof HTMLElementTagNameMap, \"html\" | \"body\">', '\"div\"');\n    }\n    return text;\n};\nif (process.env.TRACE_DIR) ts.startTracing('project', process.env.TRACE_DIR);\nconst start = performance.now();\nconst program = ts.createProgram([filename, path.join(root, 'src/cli/virtual/virtual.d.ts')], options, host);\nconst created = performance.now();\nconst diagnostics = ts.getPreEmitDiagnostics(program);\nconst result = {state, createSeconds: (created-start)/1000, checkSeconds: (performance.now()-created)/1000, types: program.getTypeCount(), instantiations: program.getInstantiationCount(), diagnostics: diagnostics.map(d => ts.flattenDiagnosticMessageText(d.messageText, '\\n'))};\nif (ts.tracing) ts.tracing.stopTracing();\nconsole.log(JSON.stringify(result));\nprocess.exitCode = diagnostics.length ? 1 : 0;\n",
